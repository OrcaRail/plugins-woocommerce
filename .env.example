# WordPress / WooCommerce local stack (see docker-compose.yml)
WORDPRESS_PORT=8088
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=rootpass

# Site URL as seen from the host (return URLs + webhook target for host API)
WORDPRESS_URL=http://127.0.0.1:8088

# Gateway → host real-flow API (must include /api/v1)
ORCARAIL_API_BASE_URL=http://host.docker.internal:3000/api/v1

# Filled by bin/woo-configure-from-real-flow.sh from demo/.env.local + __real-flow/configure-woo
# ORCARAIL_API_KEY=
# ORCARAIL_API_SECRET=
# ORCARAIL_TOKEN_ID=
# ORCARAIL_NETWORK_ID=
