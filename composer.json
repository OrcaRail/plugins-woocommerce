{
    "name": "orcarail/plugins-woocommerce",
    "description": "OrcaRail crypto payment gateway for WooCommerce",
    "type": "wordpress-plugin",
    "license": "MIT",
    "homepage": "https://github.com/OrcaRail/plugins-woocommerce",
    "require": {
        "php": "^8.1",
        "orcarail/orcarail-php": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OrcaRail\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=2G",
        "build-zip": "bash bin/build-zip.sh",
        "test:wordpress": "bash bin/run-woo-real-flow.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
